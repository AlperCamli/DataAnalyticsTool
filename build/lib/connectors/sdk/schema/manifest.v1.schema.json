{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextlayer.dev/schemas/connector-manifest/v1.json",
  "type": "object",
  "required": ["name", "version", "protocol_version", "snapshot_version",
               "capabilities", "config_schema", "rate_limit"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
    "protocol_version": { "type": "integer", "minimum": 1 },
    "snapshot_version": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "object" },
      "properties": {
        "metadata": {
          "type": "object",
          "required": ["modes"],
          "properties": {
            "modes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["ddl-file", "live", "api"] }
            }
          }
        }
      }
    },
    "config_schema": { "type": "string", "minLength": 1 },
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "required_for": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" }
        }
      }
    },
    "rate_limit": {
      "type": "object",
      "required": ["strategy"],
      "properties": { "strategy": { "enum": ["none", "token-bucket"] } }
    },
    "health_probe": { "type": "string" }
  }
}
