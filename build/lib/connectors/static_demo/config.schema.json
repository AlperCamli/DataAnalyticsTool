{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["system", "mode"],
  "additionalProperties": false,
  "properties": {
    "system": { "type": "string", "minLength": 1 },
    "mode": { "const": "ddl-file" },
    "inject_failure": { "enum": ["source_unavailable", "internal", "quota"] }
  }
}
