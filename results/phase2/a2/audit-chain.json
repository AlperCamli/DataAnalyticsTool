        "statement_text": "WITH bounds AS (\n  SELECT date_trunc('day', now()) - interval '1 day' AS day_start,\n         date_trunc('day', now())                    AS day_end\n),\nactivity AS (\n  SELECT j.user_id, 'job_tracked' AS action, j.created_at AS acted_at, NULL::integer AS tokens\n    FROM public.jobs j, bounds b\n   WHERE j.created_at >= b.day_start AND j.created_at < b.day_end\n  UNION ALL\n  SELECT t.user_id, 'cv_tailored', t.created_at, NULL::integer\n    FROM public.tailored_cvs t, bounds b\n   WHERE t.created_at >= b.day_start AND t.created_at < b.day_end\n  UNION ALL\n  SELECT e.user_id, 'export', e.created_at, NULL::integer\n    FROM public.exports e, bounds b\n   WHERE e.created_at >= b.day_start AND e.created_at < b.day_end\n  UNION ALL\n  SELECT a.user_id, 'ai_run', a.started_at, a.total_tokens\n    FROM public.ai_runs a, bounds b\n   WHERE a.started_at >= b.day_start AND a.started_at < b.day_end\n)\nSELECT u.id AS user_id,\n       u.full_name,\n       count(*) AS actions_yesterday,\n       count(*) FILTER (WHERE act.action = 'job_tracked') AS jobs_tracked,\n       count(*) FILTER (WHERE act.action = 'cv_tailored') AS cvs_tailored,\n       count(*) FILTER (WHERE act.action = 'export') AS exports_created,\n       count(*) FILTER (WHERE act.action = 'ai_run') AS ai_runs_started,\n       sum(act.tokens) AS ai_tokens_yesterday,\n       min(act.acted_at) AS first_action_at,\n       max(act.acted_at) AS last_action_at\n  FROM activity act\n  JOIN public.users u ON u.id = act.user_id\n GROUP BY u.id, u.full_name\n ORDER BY actions_yesterday DESC, last_action_at DESC",
        "decision_reason": null
    },
