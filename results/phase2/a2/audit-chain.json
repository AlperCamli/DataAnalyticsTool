        "statement_text": "WITH activity AS (\n  SELECT j.user_id, j.created_at AS acted_at FROM public.jobs j\n  UNION ALL\n  SELECT t.user_id, t.created_at FROM public.tailored_cvs t\n  UNION ALL\n  SELECT e.user_id, e.created_at FROM public.exports e\n  UNION ALL\n  SELECT a.user_id, a.started_at FROM public.ai_runs a\n),\nweekly_users AS (\n  SELECT DISTINCT date_trunc('week', acted_at)::date AS week_start, user_id\n    FROM activity\n),\nflagged AS (\n  SELECT w.week_start,\n         w.user_id,\n         EXISTS (SELECT 1 FROM weekly_users p\n                  WHERE p.user_id = w.user_id\n                    AND p.week_start = w.week_start - 7) AS is_returning\n    FROM weekly_users w\n)\nSELECT f.week_start,\n       count(*) AS active_users,\n       count(*) FILTER (WHERE f.is_returning) AS returning_users,\n       round(100.0 * count(*) FILTER (WHERE f.is_returning) / count(*), 1) AS return_rate_pct,\n       array_agg(u.full_name ORDER BY u.full_name) AS user_names\n  FROM flagged f\n  JOIN public.users u ON u.id = f.user_id\n GROUP BY f.week_start\n ORDER BY f.week_start DESC",
        "decision_reason": null
    }
]
