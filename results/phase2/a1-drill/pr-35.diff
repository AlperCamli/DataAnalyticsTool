    d.jobs_created,\n    d.cvs_tailored,\n    d.exports_created,\n    d.ai_runs_started,\n    COALESCE(ai.ai_completed, 0::numeric) AS ai_completed,\n    COALESCE(ai.ai_failed, 0::numeric) AS ai_failed,\n    COALESCE(ai.ai_pending, 0::numeric) AS ai_pending,\n    COALESCE(tr.job_transitions, 0::numeric) AS job_transitions\n   FROM reporting.v_daily_activity d\n     LEFT JOIN reporting.v_user_signups_by_day s ON s.signup_date = d.day\n     LEFT JOIN ai ON ai.run_day = d.day\n     LEFT JOIN tr ON tr.changed_day = d.day;"}},{"columns":[{"default":null,"description":null,"name":"month","nullable":true,"ordinal":1,"type":"date"},{"default":null,"description":null,"name":"days_in_month","nullable":true,"ordinal":2,"type":"bigint"},{"default":null,"description":null,"name":"active_days","nullable":true,"ordinal":3,"type":"bigint"},{"default":null,"description":null,"name":"jobs_created","nullable":true,"ordinal":4,"type":"numeric"},{"default":null,"description":null,"name":"cvs_tailored","nullable":true,"ordinal":5,"type":"numeric"},{"default":null,"description":null,"name":"exports_created","nullable":true,"ordinal":6,"type":"numeric"},{"default":null,"description":null,"name":"ai_runs_started","nullable":true,"ordinal":7,"type":"numeric"},{"default":null,"description":null,"name":"total_tokens","nullable":true,"ordinal":8,"type":"numeric"},{"default":null,"description":null,"name":"ai_non_completed","nullable":true,"ordinal":9,"type":"numeric"},{"default":null,"description":null,"name":"tailored_cvs","nullable":true,"ordinal":10,"type":"numeric"},{"default":null,"description":null,"name":"tailored_deleted","nullable":true,"ordinal":11,"type":"numeric"},{"default":null,"description":null,"name":"job_count","nullable":true,"ordinal":12,"type":"bigint"},{"default":null,"description":null,"name":"job_users","nullable":true,"ordinal":13,"type":"bigint"},{"default":null,"description":null,"name":"applied_count","nullable":true,"ordinal":14,"type":"bigint"},{"default":null,"des