ate_trunc('month'::text, (users.created_at AT TIME ZONE 'UTC'::text)) + '1 mon'::interval AS next_month\n           FROM public.users) u\n  GROUP BY cohort_month;"}},{"columns":[{"default":null,"description":null,"name":"run_day","nullable":true,"ordinal":1,"type":"date"},{"default":null,"description":null,"name":"status","nullable":true,"ordinal":2,"type":"text"},{"default":null,"description":null,"name":"run_count","nullable":true,"ordinal":3,"type":"bigint"}],"description":null,"keys":{},"kind":"view","name":"v_ai_runs_by_day","schema":"reporting","schema_hash":"sha256:befbb2a86c14fc5684b9145b937e7664678abcaae081fce34aa8506d08cef9fd","stats":{"definition":" SELECT (started_at AT TIME ZONE 'UTC'::text)::date AS run_day,\n    status,\n    count(*) AS run_count\n   FROM public.ai_runs\n  GROUP BY ((started_at AT TIME ZONE 'UTC'::text)::date), status;"}},{"columns":[{"default":null,"description":null,"name":"flow_type","nullable":true,"ordinal":1,"type":"text"},{"default":null,"description":null,"name":"provider","nullable":true,"ordinal":2,"type":"text"},{"default":null,"description":null,"name":"model_name","nullable":true,"ordinal":3,"type":"text"},{"default":null,"description":null,"name":"status","nullable":true,"ordinal":4,"type":"text"},{"default":null,"description":null,"name":"run_count","nullable":true,"ordinal":5,"type":"bigint"},{"default":null,"description":null,"name":"distinct_users","nullable":true,"ordinal":6,"type":"bigint"},{"default":null,"description":null,"name":"input_tokens","nullable":true,"ordinal":7,"type":"bigint"},{"default":null,"description":null,"name":"output_tokens","nullable":true,"ordinal":8,"type":"bigint"},{"default":null,"description":null,"name":"total_tokens","nullable":true,"ordinal":9,"type":"bigint"},{"default":null,"description":null,"name":"avg_seconds","nullable":true,"ordinal":10,"type":"numeric"}],"description":null,"keys":{},"kind":"view","name":"v_ai_runs_by_flow","schema":"reporting","schema_hash":"sha256:decb62fc93c17415b1901bbbdabe0f4676c767f640007addbb7f5aad904e1ece","stats":{"definition":" SELECT flow_type,\n    provider,\n    model_name,\n    status,\n    count(*) AS run_count,\n    count(DISTINCT user_id) AS distinct_users,\n    sum(input_tokens) AS input_tokens,\n    sum(output_tokens) AS output_tokens,\n    sum(total_tokens) AS total_tokens,\n    round(avg(EXTRACT(epoch FROM completed_at - started_at)), 2) AS avg_seconds\n   FROM public.ai_runs\n  GROUP BY flow_type, provider, model_name, status;"}},{"columns":[{"default":null,"description":null,"name":"month","nullable":true,"ordinal":1,"type":"date"},{"default":null,"description":null,"name":"provider","nullable":true,"ordinal":2,"type":"text"},{"default":null,"description":null,"name":"total_tokens","nullable":true,"ordinal":3,"type":"bigint"},{"default":null,"description":null,"name":"run_count","nullable":true,"ordinal":4,"type":"bigint"},{"default":null,"description":null,"name":"non_completed_count","nullable":true,"ordinal":5,"type":"bigint"}],"description":null,"keys":{},"kind":"view","name":"v_ai_tokens_by_month","schema":"reporting","schema_hash":"sha256:0bd767c407e3273723c4e62a1f96d03fe0d846ba5c8b211ab519010d00535706","stats":{"definition":" SELECT date_trunc('month'::text, started_at)::date AS month,\n    provider,\n    sum(total_tokens) AS total_tokens,\n    count(*) AS run_count,\n    count(*) FILTER (WHERE status <> 'completed'::text) AS non_completed_count\n   FROM public.ai_runs\n  GROUP BY (date_trunc('month'::text, started_at)::date), provider;"}},{"columns":[{"default":null,"description":null,"name":"month","nullable":true,"ordinal":1,"type":"date"},{"default":null,"description":null,"name":"language","nullable":true,"ordinal":2,"type":"text"},{"default":null,"description":null,"name":"tailored_cv_count","nullable":true,"ordinal":3,"type":"bigint"},{"default":null,"description":null,"name":"distinct_users","nullable":true,"ordinal":4,"type":"bigint"},{"default":null,"description":null,"name":"deleted_count","nullable":true,"ordinal":5,"type":"bigint"}],"description":null,"keys":{},"kind":"view","name":"v_cv_production","schema":"reporting","schema_hash":"sha256:228d079f208abe02ea559884b36e89a3a330abeaca3176a1fe215333344c08bd","stats":{"definition":" SELECT date_trunc('month'::text, created_at)::date AS month,\n    language,\n    count(*) AS tailored_cv_count,\n    count(DISTINCT user_id) AS distinct_users,\n    count(*) FILTER (WHERE is_deleted) AS deleted_count\n   FROM public.tailored_cvs\n  GROUP BY (date_trunc('month'::text, created_at)::date), language;"}},{"columns":[{"default":null,"description":null,"name":"day","nullable":true,"ordinal":1,"type":"date"},{"default":null,"description":null,"name":"jobs_created","nullable":true,"ordinal":2,"type":"bigint"},{"default":null,"description":null,"name":"cvs_tailored","nullable":true,"ordinal":3,"type":"bigint"},{"default":null,"description":null,"name":"exports_created","nullable":true,"ordinal":4,"type":"bigint"},{"default":null,"description":null,"name":"ai_runs_started","nullable":true,"ordinal":5,"type":"bigint"}],"description":null,"keys":{},"kind":"view","name":"v_daily_activity","schema":"reporting","schema_hash":"sha256:93fefebe723a600426cb0ecce19d62404db664bb97e50ddc3fd6b7844790ed5e","stats":{"definition":" SELECT d::date AS day,\n    ( SELECT count(*) AS count\n           FROM public.jobs j\n          WHERE j.created_at::date = d.d::date) AS jobs_created,\n    ( SELECT count(*) AS count\n           FROM public.tailored_cvs t\n          WHERE t.created_at::date = d.d::date) AS cvs_tailored,\n    ( SELECT count(*) AS count\n           FROM public.exports e\n          WHERE e.created_at::date = d.d::date) AS exports_created,\n    ( SELECT count(*) AS count\n           FROM public.ai_runs a\n          WHERE a.started_at::date = d.d::date) AS ai_runs_started\n   FROM generate_series((( SELECT min(jobs.created_at)::date AS min\n           FROM public.jobs))::timestamp with time zone, CURRENT_DATE::timestamp with time zone, '1 day'::interval) d(d);"}},{"columns":[{"default":null,"description":null,"name":"format","nullable":true,"ordinal":1,"type":"text"},{"default":null,"description":null,"name":"status","nullable":true,"ordinal":2,"type":"text"},{"default":null,"description":null,"name":"export_count","nullable":true,"ordinal":3,"type":"bigint"},{"default":null,"description":null,"name":"distinct_users","nullable":true,"ordinal":4,"type":"bigint"}],"description":null,"keys":{},"kind":"view","name":"v_exports_by_format","schema":"reporting","schema_hash":"sha256:23ebec8a64c7bd850eebd3897530e3f5bcba383827dae25329453280bd1d4076","stats":{"definition":" SELECT format,\n    status,\n    count(*) AS export_count,\n    count(DISTINCT user_id) AS distinct_users\n   FROM public.exports\n  GROUP BY format, status;"}},{"columns":[{"default":null,"description":null,"name":"file_type","nullable":true,"ordinal":1,"type":"text"},{"default":null,"description":null,"name":"mime_type","nullable":true,"ordinal":2,"type":"text"},{"default":null,"description":null,"name":"file_count","nullable":true,"ordinal":3,"type":"bigint"},{"default":null,"description":null,"name":"distinct_users","nullable":true,"ordinal":4,"type":"bigint"},{"default":null,"description":null,"name":"total_bytes","nullable":true,"ordinal":5,"type":"numeric"},{"default":null,"description":null,"name":"avg_bytes","nullable":true,"ordinal":6,"type":"numeric"}],"description":null,"keys":{},"kind":"view","name":"v_files_by_type","schema":"reporting","schema_hash":"sha256:77d8d34973b23250d395f62b03acaea822380965f51458723d76e4a3f6cc6ad2","stats":{"definition":" SELECT file_type,\n    mime_type,\n    count(*) AS file_count,\n    count(DISTINCT user_id) AS distinct_users,\n    sum(size_bytes) AS total_bytes,\n    round(avg(size_bytes)) AS avg_bytes\n   FROM public.files\n  WHERE NOT is_deleted\n  GROUP BY file_type, mime_type;"}},{"columns":[{"default":null,"description":null,"name":"parser_name","nullable":true,"ordinal":1,"type":"text"},{"default":null,"description":null,"name":"status","nullable":true,"ordinal":2,"type":"text"},{"default":null,"description":null,"name":"import_count","nullable":true,"ordinal":3,"type":"bigint"},{"default":null,"description":null,"name":"distinct_users","nullable":true,"ordinal":4,"type":"bigint"}],"description":null,"keys":{},"kind":"view","name":"v_imports_by_parser","schema":"reporting","schema_hash":"sha256:cb1b281c8f54924d118cd6494afcf2ab872b107d591c9adbc9011915dc8c78f4","stats":{"definition":" SELECT parser_name,\n    status,\n    count(*) AS import_count,\n    count(DISTINCT user_id) AS distinct_users\n   FROM public.imports\n  GROUP BY parser_name, status;"}},{"columns":[{"default":null,"description":null,"name":"changed_day","nullable":true,"ordinal":1,"type":"date"},{"default":null,"description":null,"name":"from_status","nullable":true,"ordinal":2,"type":"text"},{"default":null,"description":null,"name":"to_status","nullable":true,"ordinal":3,"type":"text"},{"default":null,"description":null,"name":"transitions","nullable":true,"ordinal":4,"type":"bigint"}],"description":null,"keys":{},"kind":"view","name":"v_job_status_transitions","schema":"reporting","schema_hash":"sha256:95c6baa1d34ce2f5709dff4f1feff12d5c5062114e6d1ad7cb45cf47a8855121","stats":{"definition":" SELECT (changed_at AT TIME ZONE 'UTC'::text)::date AS changed_day,\n    from_status,\n    to_status,\n    count(*) AS transitions\n   FROM public.job_status_history\n  GROUP BY ((changed_at AT TIME ZONE 'UTC'::text)::date), from_status, to_status;"}},{"columns":[{"default":null,"description":null,"name":"month","nullable":true,"ordinal":1,"type":"date"},{"default":null,"description":null,"name":"job_count","nullable":true,"ordinal":2,"type":"bigint"},{"default":null,"description":null,"name":"distinct_users","nullable":true,"ordinal":3,"type":"bigint"},{"default":null,"description":null,"name":"applied_count","nullable":true,"ordinal":4,"type":"bigint"}],"description":null,"keys":{},"kind":"view","name":"v_jobs_by_month","schema":"reporting","schema_hash":"sha256:139aa747a5499b9fd846f72f6b2215d977521874d4f31b6138b021cb57c4ee48","stats":{"definition":" SELECT date_trunc('month'::text, created_at)::date AS month,\n    count(*) AS job_count,\n    count(DISTINCT user_id) AS distinct_users,\n    count(*) FILTER (WHERE applied_at IS NOT NULL) AS applied_count\n   FROM public.jobs\n  GROUP BY (date_trunc('month'::text, created_at)::date);"}},{"columns":[{"default":null,"description":null,"name":"status","nullable":true,"ordinal":1,"type":"text"},{"default":null,"description":null,"name":"job_count","nullable":true,"ordinal":2,"type":"bigint"},{"default":null,"description":null,"name":"distinct_users","nullable":true,"ordinal":3,"type":"bigint"},{"default":null,"description":null,"name":"first_created","nullable":true,"ordinal":4,"type":"date"},{"default":null,"description":null,"name":"last_created","nullable":true,"ordinal":5,"type":"date"}],"description":null,"keys":{},"kind":"view","name":"v_jobs_by_status","schema":"reporting","schema_hash":"sha256:8ba1db1fd08c5a3bd5432b0e6e8d9f57d654a01b31ddf3f53c124f4036f9ba80","stats":{"definition":" SELECT status,\n    count(*) AS job_count,\n    count(DISTINCT user_id) AS distinct_users,\n    min(created_at)::date AS first_created,\n    max(created_at)::date AS last_created\n   FROM public.jobs\n  GROUP BY status;"}},{"columns":[{"default":null,"description":null,"name":"flow_type","nullable":true,"ordinal":1,"type":"text"},{"default":null,"description":null,"name":"provider","nullable":true,"ordinal":2,"type":"text"},{"default":null,"description":null,"name":"model_name","nullable":true,"ordinal":3,"type":"text"},{"default":null,"description":null,"name":"status","nullable":true,"ordinal":4,"type":"text"},{"default":null,"description":null,"name":"run_count","nullable":true,"ordinal":5,"type":"bigint"},{"default":null,"description":null,"name":"distinct_users","nullable":true,"ordinal":6,"type":"bigint"},{"default":null,"description":null,"name":"input_tokens","nullable":true,"ordinal":7,"type":"bigint"},{"default":null,"description":null,"name":"output_tokens","nullable":true,"ordinal":8,"type":"bigint"},{"default":null,"description":null,"name":"total_tokens","nullable":true,"ordinal":9,"type":"bigint"},{"default":null,"description":null,"name":"avg_seconds","nullable":true,"ordinal":10,"type":"numeric"}],"description":null,"keys":{},"kind":"view","name":"v_mart_dim_ai_flow","schema":"reporting","schema_hash":"sha256:41453ba96d2c936e3834fa8bcb5483ba484aa2b7960589ed90a09780386b6d0b","stats":{"definition":" SELECT flow_type,\n    provider,\n    model_name,\n    status,\n    run_count,\n    distinct_users,\n    input_tokens,\n    output_tokens,\n    total_tokens,\n    avg_seconds\n   FROM reporting.v_ai_runs_by_flow;"}},{"columns":[{"default":null,"description":null,"name":"dim","nullable":true,"ordinal":1,"type":"text"},{"default":null,"description":null,"name":"key1","nullable":true,"ordinal":2,"type":"text"},{"default":null,"description":null,"name":"key2","nullable":true,"ordinal":3,"type":"text"},{"default":null,"description":null,"name":"item_count","nullable":true,"ordinal":4,"type":"bigint"},{"default":null,"description":null,"name":"user_count","nullable":true,"ordinal":5,"type":"bigint"},{"default":null,"description":null,"name":"total_bytes","nullable":true,"ordinal":6,"type":"numeric"},{"default":null,"description":null,"name":"cancelling_count","nullable":true,"ordinal":7,"type":"bigint"}],"description":null,"keys":{},"kind":"view","name":"v_mart_dim_breakouts","schema":"reporting","schema_hash":"sha256:3c9c774ef9a3f94a4aa89215020fe4ee1e2ce3a5d0e41dab50ef1f2ce83104ed","stats":{"definition":" SELECT 'exports_by_format'::text AS dim,\n    v_exports_by_format.format AS key1,\n    v_exports_by_format.status AS key2,\n    v_exports_by_format.export_count AS item_count,\n    v_exports_by_format.distinct_users AS user_count,\n    NULL::numeric AS total_bytes,\n    NULL::bigint AS cancelling_count\n   FROM reporting.v_exports_by_format\nUNION ALL\n SELECT 'imports_by_parser'::text AS dim,\n    v_imports_by_parser.parser_name AS key1,\n    v_imports_by_parser.status AS key2,\n    v_imports_by_parser.import_count AS item_count,\n    v_imports_by_parser.distinct_users AS user_count,\n    NULL::numeric AS total_bytes,\n    NULL::bigint AS cancelling_count\n   FROM reporting.v_imports_by_parser\nUNION ALL\n SELECT 'files_by_type'::text AS dim,\n    v_files_by_type.file_type AS key1,\n    v_files_by_type.mime_type AS key2,\n    v_files_by_type.file_count AS item_count,\n    v_files_by_type.distinct_users AS user_count,\n    v_files_by_type.total_bytes,\n    NULL::bigint AS cancelling_count\n   FROM reporting.v_files_by_type\nUNION ALL\n SELECT 'master_cvs_by_language'::text AS dim,\n    v_master_cvs_by_language.language AS key1,\n    v_master_cvs_by_language.source_type AS key2,\n    v_master_cvs_by_language.master_cv_count AS item_count,\n    v_master_cvs_by_language.distinct_users AS user_count,\n    NULL::numeric AS total_bytes,\n    NULL::bigint AS cancelling_count\n   FROM reporting.v_master_cvs_by_language\nUNION ALL\n SELECT 'jobs_by_status'::text AS dim,\n    v_jobs_by_status.status AS key1,\n    NULL::text AS key2,\n    v_jobs_by_status.job_count AS item_count,\n    v_jobs_by_status.distinct_users AS user_count,\n    NULL::numeric AS total_bytes,\n    NULL::bigint AS cancelling_count\n   FROM reporting.v_jobs_by_status\nUNION ALL\n SELECT 'subscriptions_by_plan'::text AS dim,\n    v_subscriptions_by_plan.plan_code AS key1,\n    v_subscriptions_by_plan.status AS key2,\n    v_subscriptions_by_plan.subscription_count AS item_count,\n    NULL::bigint AS user_count,\n    NULL::numeric AS total_bytes,\n    v_subscriptions_by_plan.cancelling_count\n   FROM reporting.v_subscriptions_by_plan;"}},{"columns":[{"default":null,"description":null,"name":"day","nullable":true,"ordinal":1,"type":"date"},{"default":null,"description":null,"name":"new_users","nullable":true,"ordinal":2,"type":"bigint"},{"default":null,"description":null,"name":"jobs_created","nullable":true,"ordinal":3,"type":"bigint"},{"default":null,"description":null,"name":"cvs_tailored","nullable":true,"ordinal":4,"type":"bigint"},{"default":null,"description":null,"name":"exports_created","nullable":true,"ordinal":5,"type":"bigint"},{"default":null,"description":null,"name":"ai_runs_started","nullable":true,"ordinal":6,"type":"bigint"},{"default":null,"description":null,"name":"ai_completed","nullable":true,"ordinal":7,"type":"numeric"},{"default":null,"description":null,"name":"ai_failed","nullable":true,"ordinal":8,"type":"numeric"},{"default":null,"description":null,"name":"ai_pending","nullable":true,"ordinal":9,"type":"numeric"},{"default":null,"description":null,"name":"job_transitions","nullable":true,"ordinal":10,"type":"numeric"}],"description":null,"keys":{},"kind":"view","name":"v_mart_fact_daily","schema":"reporting","schema_hash":"sha256:dbc344ec4b5b1e7e43ebcf97ca4261bce7ce9457990af05494c91c0a29ef9351","stats":{"definition":" WITH ai AS (\n         SELECT v_ai_runs_by_day.run_day,\n            COALESCE(sum(v_ai_runs_by_day.run_count) FILTER (WHERE v_ai_runs_by_day.status = 'completed'::text), 0::numeric) AS ai_completed,\n            COALESCE(sum(v_ai_runs_by_day.run_count) FILTER (WHERE v_ai_runs_by_day.status = 'failed'::text), 0::numeric) AS ai_failed,\n            COALESCE(sum(v_ai_runs_by_day.run_count) FILTER (WHERE v_ai_runs_by_day.status = 'pending'::text), 0::numeric) AS ai_pending\n           FROM reporting.v_ai_runs_by_day\n          GROUP BY v_ai_runs_by_day.run_day\n        ), tr AS (\n         SELECT v_job_status_transitions.changed_day,\n            sum(v_job_status_transitions.transitions) AS job_transitions\n           FROM reporting.v_job_status_transitions\n          GROUP BY v_job_status_transitions.changed_day\n        )\n SELECT d.day,\n    COALESCE(s.new_users, 0::bigint) AS new_users,\n    d.jobs_created,\n    d.cvs_tailored,\n    d.exports_created,\n    d.ai_runs_started,\n    COALESCE(ai.ai_completed, 0::numeric) AS ai_completed,\n    COALESCE(ai.ai_failed, 0::numeric) AS ai_failed,\n    COALESCE(ai.ai_pending, 0::numeric) AS ai_pending,\n    COALESCE(tr.job_transitions, 0::numeric) AS job_transitions\n   FROM reporting.v_daily_activity d\n     LEFT JOIN reporting.v_user_signups_by_day s ON s.signup_day = d.day\n     LEFT JOIN ai ON ai.run_day = d.day\n     LEFT JOIN tr ON tr.changed_day = d.day;"}},{"columns":[{"default":null,"description":null,"name":"month","nullable":true,"ordinal":1,"type":"date"},{"default":null,"description":null,"name":"days_in_month","nullable":true,"ordinal":2,"type":"bigint"},{"default":null,"description":null,"name":"active_days","nullable":true,"ordinal":3,"type":"bigint"},{"default":null,"description":null,"name":"jobs_created","nullable":true,"ordinal":4,"type":"numeric"},{"default":null,"description":null,"name":"cvs_tailored","nullable":true,"ordinal":5,"type":"numeric"},{"default":null,"description":null,"name":"exports_created","nullable":true,"ordinal":6,"type":"numeric"},{"default":null,"description":null,"name":"ai_runs_started","nullable":true,"ordinal":7,"type":"numeric"},{"default":null,"description":null,"name":"total_tokens","nullable":true,"ordinal":8,"type":"numeric"},{"default":null,"description":null,"name":"ai_non_completed","nullable":true,"ordinal":9,"type":"numeric"},{"default":null,"description":null,"name":"tailored_cvs","nullable":true,"ordinal":10,"type":"numeric"},{"default":null,"description":null,"name":"tailored_deleted","nullable":true,"ordinal":11,"type":"numeric"},{"default":null,"description":null,"name":"job_count","nullable":true,"ordinal":12,"type":"bigint"},{"default":null,"description":null,"name":"job_users","nullable":true,"ordinal":13,"type":"bigint"},{"default":null,"description":null,"name":"applied_count","nullable":true,"ordinal":14,"type":"bigint"},{"default":null,"description":null,"name":"new_subscriptions","nullable":true,"ordinal":15,"type":"numeric"},{"default":null,"description":null,"name":"cohort_users","nullable":true,"ordinal":16,"type":"numeric"},{"default":null,"description":null,"name":"onboarded","nullable":true,"ordinal":17,"type":"numeric"},{"default":null,"description":null,"name":"signed_up","nullable":true,"ordinal":18,"type":"bigint"},{"default":null,"description":null,"name":"created_master_cv","nullable":true,"ordinal":19,"type":"bigint"},{"default":null,"description":null,"name":"created_tailored_cv","nullable":true,"ordinal":20,"type":"bigint"},{"default":null,"description":null,"name":"exported","nullable":true,"ordinal":21,"type":"bigint"},{"default":null,"description":null,"name":"subscribed","nullable":true,"ordinal":22,"type":"bigint"}],"description":null,"keys":{},"kind":"view","name":"v_mart_fact_monthly","schema":"reporting","schema_hash":"sha256:f4cd71e8f2e30e95eb84b9b1a8495e27981c23c99f8f9c893eccd56c42c66356","stats":{"definition":" WITH spine AS (\n         SELECT date_trunc('month'::text, v_daily_activity.day::timestamp with time zone)::date AS month,\n            count(*) AS days_in_month,\n            count(*) FILTER (WHERE (v_daily_activity.jobs_created + v_daily_activity.cvs_tailored + v_daily_activity.exports_created + v_daily_activity.ai_runs_started) > 0) AS active_days,\n            sum(v_daily_activity.jobs_created) AS jobs_created,\n            sum(v_daily_activity.cvs_tailored) AS cvs_tailored,\n            sum(v_daily_activity.exports_created) AS exports_created,\n            sum(v_daily_activity.ai_runs_started) AS ai_runs_started\n           FROM reporting.v_daily_activity\n          GROUP BY (date_trunc('month'::text, v_daily_activity.day::timestamp with time zone)::date)\n        ), tok AS (\n         SELECT v_ai_tokens_by_month.month,\n            sum(v_ai_tokens_by_month.total_tokens) AS total_tokens,\n            sum(v_ai_tokens_by_month.run_count) AS token_runs,\n            sum(v_ai_tokens_by_month.non_completed_count) AS ai_non_completed\n           FROM reporting.v_ai_tokens_by_month\n          GROUP BY v_ai_tokens_by_month.month\n        ), cv AS (\n         SELECT v_cv_production.month,\n            sum(v_cv_production.tailored_cv_count) AS tailored_cvs,\n            sum(v_cv_production.deleted_count) AS tailored_deleted\n           FROM reporting.v_cv_production\n          GROUP BY v_cv_production.month\n        ), sub AS (\n         SELECT v_subscriptions_new_by_month.month,\n            sum(v_subscriptions_new_by_month.new_subscriptions) AS new_subscriptions\n           FROM reporting.v_subscriptions_new_by_month\n          GROUP BY v_subscriptions_new_by_month.month\n        ), coh AS (\n         SELECT v_user_cohorts.signup_month,\n            sum(v_user_cohorts.user_count) AS cohort_users,\n            sum(v_user_cohorts.onboarded_count) AS onboarded\n           FROM reporting.v_user_cohorts\n          GROUP BY v_user_cohorts.signup_month\n        )\n SELECT s.month,\n    s.days_in_month,\n    s.active_days,\n    s.jobs_created,\n    s.cvs_tailored,\n    s.exports_created,\n    s.ai_runs_started,\n    t.total_tokens,\n    t.ai_non_completed,\n    cv.tailored_cvs,\n    cv.tailored_deleted,\n    j.job_count,\n    j.distinct_users AS job_users,\n    j.applied_count,\n    sub.new_subscriptions,\n    coh.cohort_users,\n    coh.onboarded,\n    f.signed_up,\n    f.created_master_cv,\n    f.created_tailored_cv,\n    f.exported,\n    f.subscribed\n   FROM spine s\n     LEFT JOIN tok t ON t.month = s.month\n     LEFT JOIN cv ON cv.month = s.month\n     LEFT JOIN reporting.v_jobs_by_month j ON j.month = s.month\n     LEFT JOIN sub ON sub.month = s.month\n     LEFT JOIN coh ON coh.signup_month = s.month\n     LEFT JOIN reporting.v_activation_funnel_monthly f ON f.cohort_month = s.month;"}},{"columns":[{"default":null,"description":null,"name":"language","nullable":true,"ordinal":1,"type":"text"},{"default":null,"description":null,"name":