,"finding_codes":[]},"setup_stamp":null,"snapshot_ref":{"ga4":"sha256:737f0205d50c76329cf820e622cf7c324bb250aa125f106f87c9b28513457d6a","gsc":"sha256:a40d0fab958dd8bbca4502d1a084a2947ee562e9c0fb7c8db402cea016ab836e","demo":"sha256:ac7e1c5b6a2462d128d1cff0520b8105de018b1d44aa1ea16751a7159999dde1","supabase":"sha256:4ecf4951b540c00b2b9eccc7f44661dd7d7a178f8394ddff0f1081418ebba8b7","supabase-demo":"sha256:f95d0a5c9eb5b667090c55c5b8272f02f0ad2ddda297d4be0d7e51603ba73d42"},"statement_text":"WITH activity AS (\n  SELECT j.user_id, j.created_at AS acted_at FROM public.jobs j\n  UNION ALL\n  SELECT t.user_id, t.created_at FROM public.tailored_cvs t\n  UNION ALL\n  SELECT e.user_id, e.created_at FROM public.exports e\n  UNION ALL\n  SELECT a.user_id, a.started_at FROM public.ai_runs a\n),\nweekly_users AS (\n  SELECT DISTINCT date_trunc('week', acted_at)::date AS week_start, user_id\n    FROM activity\n),\nflagged AS (\n  SELECT w.week_start,\n         w.user_id,\n         EXISTS (SELECT 1 FROM weekly_users p\n                  WHERE p.user_id = w.user_id\n                    AND p.week_start = w.week_start - 7) AS is_returning\n    FROM weekly_users w\n)\nSELECT f.week_start,\n       count(*) AS active_users,\n       count(*) FILTER (WHERE f.is_returning) AS returning_users,\n       round(100.0 * count(*) FILTER (WHERE f.is_returning) / count(*), 1) AS return_rate_pct,\n       array_agg(u.full_name ORDER BY u.full_name) AS user_names\n  FROM flagged f\n  JOIN public.users u ON u.id = f.user_id\n GROUP BY f.week_start\n ORDER BY f.week_start DESC","decision_reason":null}],"page":{"limit":6,"order":"desc","next_cursor":"eyJ0cyI6IjIwMjYtMDgtMDVUMjE6NDk6NTUuNzM3MDUyKzAwOjAwIiwiaWQiOiI3OGYyNzgyMi0wNzk2LTQxODgtOWY5ZS1lYTRmYjE2OGZmZjQifQ"}}