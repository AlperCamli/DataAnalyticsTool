{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["system", "mode"],
  "additionalProperties": false,
  "properties": {
    "system": { "type": "string", "minLength": 1 },
    "mode": { "const": "ddl-file" },
    "sleep_s": { "type": "number", "minimum": 0 }
  }
}
