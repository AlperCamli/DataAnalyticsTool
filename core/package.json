{
  "name": "@contextlayer/core",
  "version": "0.1.0",
  "private": true,
  "description": "Context Layer core service: job API + Postgres-backed queue (job protocol v1)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node web/build.mjs && tsc -p tsconfig.json",
    "build:web": "node web/build.mjs",
    "watch:web": "node web/build.mjs --watch",
    "start": "node dist/index.js",
    "migrate": "node dist/cli.js migrate",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "semver": "^7.6.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/semver": "^7.5.0",
    "esbuild": "^0.25.12",
    "fast-check": "^3.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
