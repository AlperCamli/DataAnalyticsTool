# Baseline condition `machine-kb` — toggles for the core-machine service.
#
# This service exists only in the baseline overlay, so it inherits none of
# docker-compose.yml's env files: every toggle it needs is stated here.
# CORE_MIGRATE_ON_START=0 because migrations are the enriched core's job —
# a second instance racing them on the shared ops DB is a needless
# failure mode.
CORE_MCP_ENABLED=1
CORE_DASHBOARD_ENABLED=
SYNC_ENABLED=0
CORE_MIGRATE_ON_START=0
