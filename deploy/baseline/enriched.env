# Baseline condition `enriched-kb` — toggles for the base `core` service.
#
# Listed last in that service's env_file chain (defaults → core.live.env
# → .secrets/sync.env → this), so these win. SYNC_ENABLED=0 is the point:
# the live overlay's sync.env turns sync ON, and D-75.4 requires all three
# baseline cores to be sync-OFF readers. Before D-110.2 this inversion
# happened to work only because the base file's `environment:` outranked
# sync.env; it now works because this file is last, which is a reason
# rather than an accident.
CORE_MCP_ENABLED=1
SYNC_ENABLED=0
CORE_MIGRATE_ON_START=1
