# Core feature toggles and deployment-supplied settings — dev defaults.
#
# WHY THIS FILE EXISTS (D-110.2, the third occurrence of D-84.2's shape).
# Docker Compose ranks a service's `environment:` block ABOVE its
# `env_file:` entries. So a toggle written as
#
#     environment:
#       CORE_MCP_ENABLED: ${CORE_MCP_ENABLED:-0}
#
# can never be raised by an overlay's `env_file:` — the overlay is read,
# and silently outranked. That shape has now cost the pilot two silent
# sync-off days (D-84.2), one silent dashboard-off runbook act (D-109.8),
# and one earlier occurrence. The remedy is structural: **a value a
# deployment supplies lives in an env file; only a value this compose
# file computes lives in `environment:`.**
#
# Precedence is therefore plain list order — later env files win:
#
#     docker-compose.yml            deploy/core.defaults.env   (this file)
#     deploy/compose.live.yml    →  deploy/core.live.env, .secrets/sync.env
#     deploy/compose.baseline.yml → deploy/baseline/<condition>.env
#
# One thing this does NOT do, and the reason is worth knowing: a bare
# pass-through entry (`environment: [- CORE_MCP_ENABLED]`) is not a safe
# escape hatch. Compose resolves it to null and the container ends up
# with the variable UNSET — it wipes the env-file value rather than
# deferring to it. Verified, not assumed. So there is no shell-export
# override for these keys; `make` guards against the habit
# (deploy/check-toggle-env.sh) and `/healthz` reports every one of them
# as the process actually resolved it.

# -- feature toggles (each arms or disarms a surface) --------------------
# MCP server + OAuth (CP-4). The live overlay raises this to 1.
CORE_MCP_ENABLED=0
# Dashboard (B-0/B-2). Empty = follow CORE_MCP_ENABLED (UI-9: one
# release train, one identity domain, no second deployment to turn on).
CORE_DASHBOARD_ENABLED=
# Sync orchestrator (CP-3b). Off in the plain dev stack — no KB remote here.
SYNC_ENABLED=0
# Apply pending migrations at boot. The base stack's core owns this; a
# second core sharing the ops DB sets it to 0 so the two do not race.
CORE_MIGRATE_ON_START=1

# -- sync settings a deployment supplies --------------------------------
# The live overlay's .secrets/sync.env carries the real values (KB
# remote + fine-grained PAT, ruling D2). Blank here so a plain dev stack
# stands up without them; SYNC_ENABLED=0 means nothing reads them.
SYNC_GIT_REMOTE=
SYNC_GIT_TOKEN=
SYNC_TICK_S=3600
