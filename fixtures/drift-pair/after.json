      "stats": {
        "definition": " SELECT date_trunc('day'::text, o.created_at) AS day,\n    sum(o.amount_cents) AS revenue_cents,\n    count(*) AS order_count\n   FROM orders o\n  WHERE o.status = 'paid'::text\n  GROUP BY (date_trunc('day'::text, o.created_at));"
