      "description": "Paid revenue per calendar day. Used by the Looker Studio P&L page.",
      "keys": {},
      "kind": "view",
      "name": "v_daily_revenue",
      "schema": "public",
      "schema_hash": "sha256:9799300d96ba151b4d2418deed7eb9ce23483a3e88a3a82a469dc70c714956f3",
      "stats": {
        "definition": " SELECT date_trunc('day'::text, o.created_at) AS day,\n    sum(o.total_cents) AS revenue_cents,\n    count(*) AS order_count\n   FROM orders o\n  WHERE o.status = 'paid'::text\n  GROUP BY (date_trunc('day'::text, o.created_at));"
      }
    },
