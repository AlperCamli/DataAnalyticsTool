      "kind": "materialized_view",
      "name": "mv_user_ltv",
      "schema": "public",
      "schema_hash": "sha256:51f42f2bd4cfdf410cb428545114b33f017bed8ba3564286b6de1175d31dec42",
      "stats": {
        "definition": " SELECT o.user_id,\n    sum(o.total_cents) AS ltv_cents,\n    min(o.created_at) AS first_order_at,\n    max(o.created_at) AS last_order_at\n   FROM orders o\n  WHERE o.status = 'paid'::text\n  GROUP BY o.user_id;"
      }
